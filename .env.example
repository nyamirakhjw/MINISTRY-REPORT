# Public site address. Drives canonical tags, sitemap, share links. Change at gate G-3 (custom domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep "false" while on *.vercel.app. Set "true" only after the custom domain is attached (G-3).
NEXT_PUBLIC_ALLOW_INDEXING=false
# Kiswahili stays hidden from members until every string is approved (gate G-6).
NEXT_PUBLIC_ENABLE_SW=false
# Which congregation the landing page at "/" shows.
NEXT_PUBLIC_DEFAULT_CONGREGATION=nyamira

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=
# Random 32+ character string used to hash identifiers and network addresses in the throttle log.
RATE_LIMIT_SALT=
